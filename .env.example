# Copy this file to .env and fill in values for your environment.
# Never commit .env to version control.

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=opspulse-ai
APP_VERSION=0.1.0
DEBUG=false

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
ALERT_QUEUE_NAME=alerts
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=360

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=runbooks
# QDRANT_API_KEY=           # set for Qdrant Cloud; leave unset for local

# ── RAG / Retriever ───────────────────────────────────────────────────────────
RUNBOOKS_DIR=data/runbooks
DENSE_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
DENSE_VECTOR_SIZE=384
RETRIEVAL_CANDIDATES=10
TOP_K_RESULTS=2
RRF_K=60
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── LLM providers (set at least one) ─────────────────────────────────────────
# Primary: Groq — fast inference, free tier available
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

# Fallback: Anthropic Claude
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Shared LLM settings
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# ── Slack HITL notifications ──────────────────────────────────────────────────
# Create an Incoming Webhook at: https://api.slack.com/messaging/webhooks
# HIGH and CRITICAL risk actions are posted here for human approval.
SLACK_WEBHOOK_URL=
SLACK_TIMEOUT=10

# ── LangGraph / Agent ─────────────────────────────────────────────────────────
AGENT_MAX_RETRIES=2
HITL_RISK_TIERS=["HIGH","CRITICAL"]
LANGGRAPH_RECURSION_LIMIT=25

# ── LangSmith observability (optional) ────────────────────────────────────────
# Enable distributed tracing for every LangGraph run.
# Get key at: https://smith.langchain.com/
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=opspulse-ai

# ── Docker sandbox ────────────────────────────────────────────────────────────
# Unix socket (Linux/macOS):
DOCKER_BASE_URL=unix://var/run/docker.sock
# Windows named pipe (uncomment on Windows with Docker Desktop):
# DOCKER_BASE_URL=npipe:////./pipe/docker_engine
DOCKER_TIMEOUT=30
SANDBOX_NETWORK_NAME=opspulse_sandbox
SANDBOX_RESTART_TIMEOUT=10
SANDBOX_LOG_LINES=100
# Comma-separated container name prefixes the sandbox may operate on.
# Leave empty for dev (all containers allowed). In production set explicitly:
# SANDBOX_ALLOWED_PREFIXES=["payment-","order-","auth-"]
SANDBOX_ALLOWED_PREFIXES=[]

# ── Prometheus metrics ────────────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_NAMESPACE=opspulse
# Metrics are served at GET /metrics by the FastAPI app.
# Scrape with Prometheus: http://<host>:8000/metrics
